# Historical source-frame review images stay on H20, not in the public GitHub snapshot.
/docs/current/visuals/FOUR_STREAM_V5/ISSUE_*_DEVICE_OBJECT.jpg

# Secrets and local credentials
.env
.env.*
*.pem
*.key
/.secrets/
/secrets/
credentials*.json
*_token.txt

# Python/editor caches (must be absent from final worktree)
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.DS_Store
.idea/
.vscode/
.venv/
venv/

# Isolated runtime and archive roots
/archive/
/_run/current/**
!/_run/current/.gitkeep
/_run/caches/
/_run/cache/
/.cache/
# Existing caches remain local; do not upload or delete them during documentation work.

# Local maintenance evidence and known pytest runtime copies are not source.
# Ignoring a path does not authorize deleting it; deletion proof is unchanged.
/_run/maintenance/
/_run/tmp/
/.tmp/
/tests/pick_place_1008/_tmp_*/
/docs/plans/PICK_PLACE_1008_RAW_TO_ROBOT_V1/reverse_native_boundary_v9/test_tmp_v9_full/

# Raw/review image and array payloads stay local. Their JSON provenance,
# review scripts, plans and real test source remain eligible for Git tracking.
/review/**/*.png
/review/**/*.jpg
/review/**/*.jpeg
/review/**/*.webp
/review/**/*.npy
/review/**/*.npz
/docs/plans/PICK_PLACE_1008_RAW_TO_ROBOT_V1/**/*.png
/docs/plans/PICK_PLACE_1008_RAW_TO_ROBOT_V1/**/*.jpg
/docs/plans/PICK_PLACE_1008_RAW_TO_ROBOT_V1/**/*.jpeg
/docs/plans/PICK_PLACE_1008_RAW_TO_ROBOT_V1/**/*.npy
/docs/plans/PICK_PLACE_1008_RAW_TO_ROBOT_V1/**/*.npz

# Model payloads are local; manifests remain tracked
/assets/models/**
!/assets/models/README.md
!/assets/models/MANIFEST.json

