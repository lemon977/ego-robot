# Secrets and local credentials
.env
.env.*
*.pem
*.key
/.secrets/
/secrets/
credentials*.json
*_token.txt

# Python/editor caches (must be absent from final worktree)
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.DS_Store
.idea/
.vscode/
.venv/
venv/

# Isolated runtime and archive roots
/archive/
/_run/current/**
!/_run/current/.gitkeep
/_run/caches/

# Model payloads are local; manifests remain tracked
/assets/models/**
!/assets/models/README.md
!/assets/models/MANIFEST.json

# Generated or heavyweight payloads must live only in allowed roots
*.log
*.lock
*.tmp
*.bak
*.pre_*
*.pt
*.pth
*.ckpt
*.onnx
*.mp4
*.avi
*.mov
*.zip
*.tar
*.tar.gz

# Fixed local hardware/model payloads
/assets/calibration/pico_manus_legacy_20260914/config/*.mcal
/assets/robot/tianji/
/assets/robot/kaihand/packages/
*.STL
*.stl
