# Secrets and local credentials
.env
.env.*
*.pem
*.key
/.secrets/
/secrets/
credentials*.json
*_token.txt

# Python/editor/runtime caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.DS_Store
.idea/
.vscode/
.venv/
venv/

# All runtime and promoted data stay local
/_run/*
!/_run/.gitkeep
/data/processed/**
!/data/processed/**/README.md
!/data/processed/**/SOURCE_MANIFEST.json
!/data/processed/**/STATUS.json
/tasks/*/runs/*/*
!/tasks/*/runs/*/README.md
/tasks/*/annotations/*/*
!/tasks/*/annotations/README.md
/tasks/*/exports/*
!/tasks/*/exports/README.md
/data/benchmarks/hand/production_runs/
/HumanEgo/runs/
/HumanEgo/outputs/
/HumanEgo/reports/
/HumanEgo/artifacts/
/archive/
/docs/history/
/docs/organization/
/docs/collaboration/
*.log
*.lock
*.tmp
*.bak
*.pre_*

# Large numerical/model artifacts
*.pt
*.pth
*.ckpt
*.onnx
/assets/environments/*-v1/
/assets/calibration/pico_manus_legacy_20260914/config/*.mcal
/HumanEgo/data_manifests/robot_sidecars_v4_candidate/**/*.npz
/third_party/HaWoR/weights/
/third_party/HaWoR/_DATA/data/mano/*.pkl
/third_party/HaWoR/_DATA/data_left/mano_left/*.pkl

# Media, archives and generated frames
*.mp4
*.avi
*.mov
*.zip
*.tar
*.tar.gz

# Robot assets stay local until redistribution rights are confirmed
/assets/robot/tianji/
/assets/robot/kaihand/packages/
*.STL
*.stl
/HumanEgo/vendor/
