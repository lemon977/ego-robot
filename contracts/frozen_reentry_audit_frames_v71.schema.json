{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chaoyang-frozen-reentry-audit-frames-v71",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_revision",
    "immutable",
    "authority",
    "audit_set_type",
    "transition_signal",
    "gold_accuracy_authorized",
    "selection_groups",
    "rows",
    "counts",
    "source_evidence",
    "producer_signature",
    "claim_limit"
  ],
  "properties": {
    "schema_version": {"const": "frozen-reentry-audit-frames-v71"},
    "artifact_id": {"const": "FROZEN_REENTRY_AUDIT_FRAMES_V71"},
    "artifact_revision": {"const": "R7_1"},
    "immutable": {"const": true},
    "authority": {"const": false},
    "audit_set_type": {"const": "DEVELOPMENT_AUDIT_FRAME_SELECTION"},
    "transition_signal": {"const": "OBJECT_MASK_OBSERVED_AND_VALID_AND_NONEMPTY"},
    "gold_accuracy_authorized": {"const": false},
    "selection_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["group_id", "stage", "task", "failure_canary", "regressions"],
        "properties": {
          "group_id": {"type": "string"},
          "stage": {"enum": ["role_mask", "object_identity"]},
          "task": {"enum": ["chips", "poker"]},
          "failure_canary": {"type": "string"},
          "regressions": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group_id", "stage", "task", "session_id", "selection_role",
          "physical_instance_id", "role_mask_grade", "object_mask_grade",
          "status", "source_manifest"
        ],
        "properties": {
          "group_id": {"type": "string"},
          "stage": {"enum": ["role_mask", "object_identity"]},
          "task": {"enum": ["chips", "poker"]},
          "session_id": {"type": "string"},
          "selection_role": {"enum": ["FAILURE_CANARY", "A_B_REGRESSION"]},
          "physical_instance_id": {"type": "integer", "minimum": 0},
          "role_mask_grade": {"enum": ["A", "B", "C", "UNKNOWN"]},
          "object_mask_grade": {"enum": ["A", "B", "C", "UNKNOWN"]},
          "status": {"enum": ["FROZEN_EVENT", "BLOCKED_INSUFFICIENT_TRANSITION_EVIDENCE"]},
          "blocked_reason": {"type": ["string", "null"]},
          "source_manifest": {
            "anyOf": [
              {"$ref": "#/$defs/evidence"},
              {"type": "null"}
            ]
          },
          "event": {
            "type": ["object", "null"],
            "properties": {
              "event_id": {"type": "string"},
              "last_visible_before": {"type": "integer", "minimum": 0},
              "empty_or_unobserved_start": {"type": "integer", "minimum": 0},
              "empty_or_unobserved_end": {"type": "integer", "minimum": 0},
              "first_visible_after": {"type": "integer", "minimum": 0},
              "empty_run_length": {"type": "integer", "minimum": 1},
              "window_start": {"type": "integer", "minimum": 0},
              "window_end": {"type": "integer", "minimum": 0},
              "audit_frames": {
                "type": "array",
                "minItems": 3,
                "items": {"type": "integer", "minimum": 0}
              },
              "transition_semantics": {"const": "VISIBLE_TO_EMPTY_OR_UNOBSERVED_TO_VISIBLE"}
            },
            "required": [
              "event_id", "last_visible_before", "empty_or_unobserved_start",
              "empty_or_unobserved_end", "first_visible_after", "empty_run_length",
              "window_start", "window_end", "audit_frames", "transition_semantics"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "counts": {"type": "object"},
    "source_evidence": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "producer_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claim_limit": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
