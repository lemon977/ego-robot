{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handle_canonical_hand_ledger_v71.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_revision", "validity", "generated_at", "stage", "source_h0", "row_count", "summary", "rows", "claim_limit", "observation_contract"],
  "properties": {
    "schema_version": {"const": "handle-canonical-hand-ledger-v7.1"},
    "artifact_revision": {"const": "R7_0"},
    "validity": {"const": "VALID_FOR_PINNED_REVISION"},
    "generated_at": {"type": "string"},
    "stage": {"const": "h1"},
    "source_h0": {"$ref": "#/$defs/evidence"},
    "row_count": {"type": "integer", "minimum": 0},
    "summary": {"$ref": "#/$defs/summary"},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "claim_limit": {"type": "string", "minLength": 20},
    "observation_contract": {
      "type": "object",
      "required": ["name", "side_order", "joint_names", "manus25_source_names", "hand21_from_manus25", "omitted_source_nodes", "wrist_source", "coordinate_views"],
      "properties": {
        "name": {"const": "HAND21_FROM_MANUS_CONTROLLER"},
        "side_order": {"const": ["left", "right"]},
        "joint_names": {"type": "array", "minItems": 21, "maxItems": 21, "items": {"type": "string"}},
        "manus25_source_names": {"type": "array", "minItems": 25, "maxItems": 25, "items": {"type": "string"}},
        "hand21_from_manus25": {"type": "array", "minItems": 21, "maxItems": 21, "items": {"type": "integer"}},
        "omitted_source_nodes": {"type": "array", "items": {"type": "string"}},
        "wrist_source": {"type": "string"},
        "coordinate_views": {"const": ["wrist_local_m", "world_m", "camera_m"]}
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["by_status", "total_frames"],
      "properties": {
        "by_status": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "total_frames": {"type": "integer", "minimum": 0}
      }
    },
    "row": {
      "type": "object",
      "required": ["session_id", "dataset_id", "task", "frame_count", "status", "primary_blocker", "artifact", "downstream"],
      "properties": {
        "session_id": {"type": "string"}, "dataset_id": {"type": "string"},
        "task": {"enum": ["potato_chips", "playing_cards"]},
        "frame_count": {"type": ["integer", "null"], "minimum": 0},
        "status": {"enum": ["PASSED", "BLOCKED_SOURCE", "BLOCKED_PREREQ_CONTROLLER_WRIST", "FAILED_QUALITY_C", "FAILED_RUNTIME_FINAL"]},
        "primary_blocker": {"type": ["string", "null"]},
        "artifact": {"oneOf": [{"$ref": "#/$defs/evidence"}, {"type": "null"}]},
        "source_hdf5": {
          "type": "object", "required": ["path", "sha256"],
          "properties": {"path": {"type": "string", "pattern": "^/"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        },
        "metrics": {"type": "object"},
        "downstream": {
          "type": "object", "additionalProperties": false,
          "required": ["hand_observation_eligible", "robot_geometry_eligible"],
          "properties": {"hand_observation_eligible": {"type": "boolean"}, "robot_geometry_eligible": {"type": "boolean"}}
        }
      }
    }
  }
}
