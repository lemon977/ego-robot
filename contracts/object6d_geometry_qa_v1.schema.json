{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chaoyang://contracts/object6d-geometry-qa-v1",
  "title": "OBJECT6D_GEOMETRY_QA_V1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "session_id", "status", "coordinate_domain", "objects", "visible_surface_center_semantics", "temporal_diagnostics_are_failure_gates"],
  "properties": {
    "schema_version": {"const": "OBJECT6D_GEOMETRY_QA_V1"},
    "session_id": {"type": "string"},
    "status": {"enum": ["PASS", "REJECTED_QUALITY", "BLOCKED_UPSTREAM"]},
    "coordinate_domain": {"type": "string"},
    "visible_surface_center_semantics": {"const": "DIRECT_VISIBLE_SURFACE_CENTROID_NOT_OBJECT_FIXED_CENTER"},
    "temporal_diagnostics_are_failure_gates": {"const": false},
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["instance_id", "frame_count", "hard_gate", "temporal_diagnostics"],
        "properties": {
          "instance_id": {"type": "string"},
          "frame_count": {"const": 150},
          "hard_gate": {"type": "object"},
          "temporal_diagnostics": {"type": "object"}
        }
      }
    }
  }
}
