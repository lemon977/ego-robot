{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ego-robot.local/contracts/reveal_labels.schema.json",
  "title": "G2 Reveal Labels",
  "x-document-status": "DRAFT",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_state", "producer", "session_id", "product_line",
    "mask_evidence_ref", "object_evidence_ref", "route_decision_ref", "verified_reveal_policy_ref",
    "task_card_ref", "calibration_overlay_ref", "allowed_routes", "hidden_fallback_used",
    "formal_consumable", "frame_count", "frames", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "reveal-labels-v1"},
    "artifact_state": {"const": "G2_CALIBRATION_CANDIDATE"},
    "producer": {"const": "reveal_router"},
    "session_id": {"const": "grap_a_cap_004"},
    "product_line": {"const": "004_CONTACT_GOLD"},
    "mask_evidence_ref": {"$ref": "#/$defs/ref"},
    "object_evidence_ref": {"$ref": "#/$defs/ref"},
    "route_decision_ref": {"$ref": "#/$defs/ref"},
    "verified_reveal_policy_ref": {"$ref": "#/$defs/revealPolicyRef"},
    "task_card_ref": {"$ref": "#/$defs/ref"},
    "calibration_overlay_ref": {"$ref": "#/$defs/ref"},
    "allowed_routes": {"const": ["ANALYTIC_GEOMETRY_TEXTURE", "TEMPORAL_DONOR_ATLAS"]},
    "hidden_fallback_used": {"const": false},
    "formal_consumable": {"const": false},
    "frame_count": {"const": 460},
    "frames": {
      "type": "array",
      "minItems": 460,
      "maxItems": 460,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frame_index", "reveal_label_map", "target_mask", "o_visible_core",
          "object_route", "background_route", "object_texture_donor_ref",
          "temporal_atlas_manifest_ref", "pre_route_identity", "post_route_identity",
          "route_coverage", "hold", "hold_reasons", "unsupported_pixel_count", "evidence_refs"
        ],
        "properties": {
          "frame_index": {"type": "integer", "minimum": 0, "maximum": 459},
          "reveal_label_map": {"$ref": "#/$defs/ref"},
          "target_mask": {"$ref": "#/$defs/ref"},
          "o_visible_core": {"$ref": "#/$defs/ref"},
          "object_route": {"enum": ["ANALYTIC_GEOMETRY_TEXTURE", "HOLD_UNSUPPORTED", "NOT_REQUIRED"]},
          "background_route": {"enum": ["TEMPORAL_DONOR_ATLAS", "HOLD_UNSUPPORTED", "NOT_REQUIRED"]},
          "object_texture_donor_ref": {
            "oneOf": [{"type": "null"}, {"$ref": "#/$defs/objectTextureDonorRef"}]
          },
          "temporal_atlas_manifest_ref": {
            "oneOf": [{"type": "null"}, {"$ref": "#/$defs/temporalAtlasRef"}]
          },
          "pre_route_identity": {"$ref": "#/$defs/preRouteIdentity"},
          "post_route_identity": {"$ref": "#/$defs/postRouteIdentity"},
          "route_coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["object", "background"],
            "properties": {
              "object": {"$ref": "#/$defs/routeCoverage"},
              "background": {"$ref": "#/$defs/routeCoverage"}
            }
          },
          "hold": {"type": "boolean"},
          "hold_reasons": {
            "type": "array", "uniqueItems": true,
            "items": {"enum": [
              "VERIFIED_POLICY_MISSING", "VERIFIED_POLICY_INVALID",
              "OBJECT_IDENTITY_UNSUPPORTED", "BACKGROUND_IDENTITY_UNSUPPORTED",
              "CONTRADICTORY_REVEAL_IDENTITY", "VISIBLE_OBJECT_MASK_CONFLICT",
              "OBJECT_DONOR_QUALITY_UNVERIFIED_OR_BELOW_THRESHOLD",
              "BACKGROUND_DONOR_QUALITY_UNVERIFIED_OR_BELOW_THRESHOLD",
              "ROUTE_COVERAGE_BELOW_THRESHOLD"
            ]}
          },
          "unsupported_pixel_count": {"type": "integer", "minimum": 0},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}
        },
        "allOf": [
          {
            "if": {"properties": {"hold": {"const": true}}},
            "then": {
              "properties": {
                "unsupported_pixel_count": {"minimum": 1},
                "hold_reasons": {"minItems": 1}
              }
            },
            "else": {
              "properties": {
                "unsupported_pixel_count": {"const": 0},
                "hold_reasons": {"maxItems": 0}
              }
            }
          }
        ]
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "producer"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "producer": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "revealPolicyRef": {
      "allOf": [
        {"$ref": "#/$defs/ref"},
        {"required": ["schema_version", "bytes"], "properties": {"producer": {"const": "reveal_policy_owner"}, "schema_version": {"const": "reveal-policy-v1"}}}
      ]
    },
    "objectTextureDonorRef": {
      "allOf": [
        {"$ref": "#/$defs/ref"},
        {"required": ["schema_version", "bytes"], "properties": {"producer": {"const": "object_geometry_producer"}, "schema_version": {"const": "object-texture-donor-v1"}}}
      ]
    },
    "temporalAtlasRef": {
      "allOf": [
        {"$ref": "#/$defs/ref"},
        {"required": ["schema_version", "bytes"], "properties": {"producer": {"const": "temporal_donor_atlas"}, "schema_version": {"const": "temporal-background-donor-v1"}}}
      ]
    },
    "preRouteIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_pixel_count", "object_geometry_overlap_pixel_count",
        "background_identity_overlap_pixel_count", "protected_o_visible_overlap_pixel_count",
        "contradictory_identity_pixel_count", "evidence_ref"
      ],
      "properties": {
        "target_pixel_count": {"type": "integer", "minimum": 0},
        "object_geometry_overlap_pixel_count": {"type": "integer", "minimum": 0},
        "background_identity_overlap_pixel_count": {"type": "integer", "minimum": 0},
        "protected_o_visible_overlap_pixel_count": {"type": "integer", "minimum": 0},
        "contradictory_identity_pixel_count": {"type": "integer", "minimum": 0},
        "evidence_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "postRouteIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reveal_object_pixel_count", "reveal_background_pixel_count", "hold_pixel_count",
        "object_background_overlap_pixel_count", "assigned_outside_target_pixel_count",
        "accounting_error_pixel_count", "protected_object_overwrite_pixel_count", "evidence_ref"
      ],
      "properties": {
        "reveal_object_pixel_count": {"type": "integer", "minimum": 0},
        "reveal_background_pixel_count": {"type": "integer", "minimum": 0},
        "hold_pixel_count": {"type": "integer", "minimum": 0},
        "object_background_overlap_pixel_count": {"const": 0},
        "assigned_outside_target_pixel_count": {"const": 0},
        "accounting_error_pixel_count": {"const": 0},
        "protected_object_overwrite_pixel_count": {"const": 0},
        "evidence_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "routeCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_pixel_count", "supported_pixel_count", "coverage_ratio", "threshold_ref", "decision", "evidence_refs"],
      "properties": {
        "required_pixel_count": {"type": "integer", "minimum": 0},
        "supported_pixel_count": {"type": "integer", "minimum": 0},
        "coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "threshold_ref": {"$ref": "#/$defs/ref"},
        "decision": {"enum": ["PASS", "HOLD"]},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}
      }
    }
  }
}
