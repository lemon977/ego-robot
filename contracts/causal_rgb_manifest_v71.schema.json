{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaoyang.local/contracts/causal_rgb_manifest_v71.schema.json",
  "title": "Frozen ordered RGB inputs for a causal mask challenger",
  "type": "object",
  "required": ["schema_version", "artifact_id", "artifact_revision", "session_id", "frozen", "execution_mode", "frames"],
  "properties": {
    "schema_version": {"const": "causal-rgb-manifest-v71"},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_revision": {"type": "string", "pattern": "^R7_[0-9]+(?:[._-][A-Za-z0-9]+)*$"},
    "session_id": {"type": "string", "minLength": 1},
    "frozen": {"const": true},
    "execution_mode": {"const": "CAUSAL_PROCESSING"},
    "frames": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["frame_id", "path", "bytes", "sha256"],
        "properties": {
          "frame_id": {"type": "integer", "minimum": 0},
          "path": {"type": "string", "pattern": "^/"},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "additionalProperties": true
}
