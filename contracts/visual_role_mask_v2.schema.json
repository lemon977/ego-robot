{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-role-mask-v2.schema.json",
  "title": "Persistent role-instance masks with explicit temporal evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "session_id", "frame_count", "image_domain", "model",
    "roles", "instances", "derived_masks", "temporal_state_ledger",
    "tracker_role_created", "controller_role_created", "pico26_consumed"
  ],
  "properties": {
    "schema_version": {"const": "visual-role-mask-v2"},
    "session_id": {"const": "play_cards_0915_001"},
    "frame_count": {"const": 150},
    "image_domain": {"const": "PHYSICAL_LEFT_SOURCE_INDEX_1_RESIZE_ONLY_NO_REMAP"},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "weight_sha256", "runtime_class", "initial_box_semantics"],
      "properties": {
        "identity": {"const": "SAM3.1"},
        "weight_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_class": {"const": "Sam3MultiplexTrackingWithInteractivity"},
        "initial_box_semantics": {"const": "MULTIPLEX_GEOMETRIC_BOX"}
      }
    },
    "roles": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/role"}
    },
    "instances": {
      "type": "array", "minItems": 11,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "instance_id", "role", "physical_identity_policy", "mask_archive",
          "state_counts", "initial_box_prompt", "reseed_count"
        ],
        "properties": {
          "instance_id": {"type": "string", "minLength": 1},
          "role": {"$ref": "#/$defs/role"},
          "physical_identity_policy": {
            "enum": [
              "SIDE_LOCKED_HUMAN_ROLE", "ROLE_INSTANCE_UNKNOWN_AFTER_EXIT",
              "SEPARATE_VISIBLE_PHYSICAL_OBJECT"
            ]
          },
          "mask_archive": {"type": "string", "minLength": 1},
          "state_counts": {
            "type": "object", "additionalProperties": false,
            "required": ["seeded", "tracked", "reseeded", "unknown"],
            "properties": {
              "seeded": {"type": "integer", "minimum": 0},
              "tracked": {"type": "integer", "minimum": 0},
              "reseeded": {"type": "integer", "minimum": 0},
              "unknown": {"type": "integer", "minimum": 0}
            }
          },
          "initial_box_prompt": {"type": "object"},
          "reseed_count": {"type": "integer", "minimum": 0, "maximum": 1}
        }
      }
    },
    "derived_masks": {
      "type": "object", "additionalProperties": false,
      "required": ["human_equipment_union"],
      "properties": {
        "human_equipment_union": {
          "type": "object", "additionalProperties": false,
          "required": ["mask_archive", "source_roles", "direction"],
          "properties": {
            "mask_archive": {"type": "string", "minLength": 1},
            "source_roles": {"type": "array", "items": {"$ref": "#/$defs/role"}},
            "direction": {"const": "DERIVED_FROM_ROLE_MASKS_ONLY"}
          }
        }
      }
    },
    "temporal_state_ledger": {"type": "string", "minLength": 1},
    "tracker_role_created": {"const": false},
    "controller_role_created": {"const": false},
    "pico26_consumed": {"const": false}
  },
  "$defs": {
    "role": {
      "enum": [
        "left_hand", "right_hand", "left_forearm", "right_forearm",
        "left_finger_sleeve", "right_finger_sleeve", "left_cable",
        "right_cable", "task_object"
      ]
    }
  }
}
