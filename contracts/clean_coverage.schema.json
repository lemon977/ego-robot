{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ego-robot.local/contracts/clean_coverage.schema.json",
  "title": "G2 Clean Coverage Evidence",
  "x-document-status": "DRAFT",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_state", "producer", "session_id", "product_line",
    "clean_layers_ref", "reveal_labels_ref", "verified_reveal_policy_ref",
    "object_texture_donor_manifest_refs", "temporal_atlas_manifest_refs",
    "task_card_ref", "calibration_overlay_ref",
    "threshold_review_state", "formal_gate_claim_allowed", "frame_count", "frames", "session_summary", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "clean-coverage-v1"},
    "artifact_state": {"const": "G2_CALIBRATION_CANDIDATE"},
    "producer": {"const": "clean_background_producer"},
    "session_id": {"const": "grap_a_cap_004"},
    "product_line": {"const": "004_CONTACT_GOLD"},
    "clean_layers_ref": {"$ref": "#/$defs/ref"},
    "reveal_labels_ref": {"$ref": "#/$defs/ref"},
    "verified_reveal_policy_ref": {"$ref": "#/$defs/revealPolicyRef"},
    "object_texture_donor_manifest_refs": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/objectTextureDonorRef"}
    },
    "temporal_atlas_manifest_refs": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/temporalAtlasRef"}
    },
    "task_card_ref": {"$ref": "#/$defs/ref"},
    "calibration_overlay_ref": {"$ref": "#/$defs/ref"},
    "threshold_review_state": {"const": "UNREVIEWED_CALIBRATION_OVERLAY"},
    "formal_gate_claim_allowed": {"const": false},
    "frame_count": {"const": 460},
    "frames": {
      "type": "array",
      "minItems": 460,
      "maxItems": 460,
      "items": {"$ref": "#/$defs/frameCoverage"}
    },
    "session_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_reveal_coverage", "background_reveal_coverage", "unsupported_ratio", "hold_frame_count"],
      "properties": {
        "object_reveal_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "background_reveal_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "unsupported_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "hold_frame_count": {"type": "integer", "minimum": 0, "maximum": 460}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "producer"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "producer": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "frameCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_index", "object_reveal_coverage", "background_reveal_coverage", "pre_route_identity_ref",
        "post_route_identity_ref", "object_route_decision", "background_route_decision",
        "object_donor_ref", "background_donor_ref", "unsupported_pixel_count",
        "photometric_residual", "flow_consistency", "hold", "hold_reasons", "evidence_refs"
      ],
      "properties": {
        "frame_index": {"type": "integer", "minimum": 0, "maximum": 459},
        "object_reveal_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "background_reveal_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "pre_route_identity_ref": {"$ref": "#/$defs/ref"},
        "post_route_identity_ref": {"$ref": "#/$defs/ref"},
        "object_route_decision": {"enum": ["PASS", "HOLD"]},
        "background_route_decision": {"enum": ["PASS", "HOLD"]},
        "object_donor_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/objectTextureDonorRef"}]},
        "background_donor_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/temporalAtlasRef"}]},
        "unsupported_pixel_count": {"type": "integer", "minimum": 0},
        "photometric_residual": {"type": ["number", "null"], "minimum": 0},
        "flow_consistency": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "hold": {"type": "boolean"},
        "hold_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}
      },
      "allOf": [
        {
          "if": {"properties": {"hold": {"const": true}}},
          "then": {
            "properties": {
              "unsupported_pixel_count": {"minimum": 1},
              "hold_reasons": {"minItems": 1}
            }
          },
          "else": {
            "properties": {
              "unsupported_pixel_count": {"const": 0},
              "hold_reasons": {"maxItems": 0},
              "object_route_decision": {"const": "PASS"},
              "background_route_decision": {"const": "PASS"}
            }
          }
        }
      ]
    },
    "revealPolicyRef": {
      "allOf": [
        {"$ref": "#/$defs/ref"},
        {"required": ["schema_version", "bytes"], "properties": {"producer": {"const": "reveal_policy_owner"}, "schema_version": {"const": "reveal-policy-v1"}}}
      ]
    },
    "objectTextureDonorRef": {
      "allOf": [
        {"$ref": "#/$defs/ref"},
        {"required": ["schema_version", "bytes"], "properties": {"producer": {"const": "object_geometry_producer"}, "schema_version": {"const": "object-texture-donor-v1"}}}
      ]
    },
    "temporalAtlasRef": {
      "allOf": [
        {"$ref": "#/$defs/ref"},
        {"required": ["schema_version", "bytes"], "properties": {"producer": {"const": "temporal_donor_atlas"}, "schema_version": {"const": "temporal-background-donor-v1"}}}
      ]
    }
  }
}
