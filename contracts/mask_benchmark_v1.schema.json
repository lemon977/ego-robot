{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ego-robot.local/contracts/mask_benchmark_v1.schema.json",
  "title": "Frozen H/O/U/B MASK Benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_state", "producer", "benchmark_id",
    "uncertainty_policy", "frames", "temporal_pairs", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "mask-benchmark-v1"},
    "artifact_state": {"enum": ["FROZEN", "SYNTHETIC_TEST_ONLY"]},
    "producer": {"const": "mask_benchmark_curator"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "uncertainty_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels", "u_excluded_from_metrics", "manual_labels_required"],
      "properties": {
        "labels": {"const": ["H", "O", "U", "B"]},
        "u_excluded_from_metrics": {"const": true},
        "manual_labels_required": {"const": true}
      }
    },
    "frames": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_id", "session_id", "frame_index", "split", "source_image"],
        "properties": {
          "sample_id": {"type": "string", "minLength": 1},
          "session_id": {"type": "string", "minLength": 1},
          "frame_index": {"type": "integer", "minimum": 0},
          "split": {"enum": ["development", "same_session_blind", "cross_session_blind"]},
          "source_image": {"$ref": "#/$defs/ref"}
        }
      }
    },
    "temporal_pairs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pair_id", "from_sample_id", "to_sample_id"],
        "properties": {
          "pair_id": {"type": "string", "minLength": 1},
          "from_sample_id": {"type": "string", "minLength": 1},
          "to_sample_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "properties": {
        "frames": {
          "allOf": [
            {"contains": {"properties": {"split": {"const": "development"}}, "required": ["split"]}, "minContains": 1},
            {"contains": {"properties": {"split": {"const": "same_session_blind"}}, "required": ["split"]}, "minContains": 1},
            {"contains": {"properties": {"split": {"const": "cross_session_blind"}}, "required": ["split"]}, "minContains": 1}
          ]
        }
      }
    },
    {
      "if": {"properties": {"artifact_state": {"const": "FROZEN"}}},
      "then": {
        "properties": {
          "frames": {
            "minItems": 45,
            "maxItems": 60,
            "allOf": [
              {"contains": {"properties": {"split": {"const": "development"}}, "required": ["split"]}, "minContains": 15},
              {"contains": {"properties": {"split": {"const": "same_session_blind"}}, "required": ["split"]}, "minContains": 15},
              {"contains": {"properties": {"split": {"const": "cross_session_blind"}}, "required": ["split"]}, "minContains": 15}
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "producer", "schema_version"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "producer": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1}
      }
    }
  }
}
