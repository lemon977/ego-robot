{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaoyang.local/contracts/removal_envelope_v1.schema.json",
  "title": "Removal Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "session_id",
    "frame_count",
    "image_domain",
    "layers",
    "input_closure",
    "policies",
    "frame_ledger",
    "quality_admission",
    "consumer_firewall",
    "claim_limit"
  ],
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authority", "mutation_allowed", "artifacts"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "mutation_allowed": {"const": false},
        "artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact_ref"}
        },
        "reason": {"type": "string"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "removal-envelope-v1"},
    "task_id": {"const": "0915_removal_envelope_single_session_canary_v1"},
    "session_id": {"const": "play_cards_0915_001"},
    "frame_count": {"const": 150},
    "image_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "width", "height", "source_index", "remap_applied"],
      "properties": {
        "identity": {"const": "PHYSICAL_LEFT_SOURCE_INDEX_1_RESIZE_ONLY_NO_REMAP"},
        "width": {"const": 1280},
        "height": {"const": 960},
        "source_index": {"const": 1},
        "remap_applied": {"const": false}
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_candidate", "semantic_role", "removal_envelope", "feather_alpha"],
      "properties": {
        "raw_candidate": {"$ref": "#/$defs/layer"},
        "semantic_role": {"$ref": "#/$defs/layer"},
        "removal_envelope": {"$ref": "#/$defs/layer"},
        "feather_alpha": {"$ref": "#/$defs/layer"}
      }
    },
    "input_closure": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact_ref"}
    },
    "policies": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mano", "forearm", "cable", "object_protection"]
    },
    "frame_ledger": {"$ref": "#/$defs/artifact_ref"},
    "quality_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_status",
        "removal_status",
        "automatic_gates",
        "human_review_required"
      ],
      "properties": {
        "semantic_status": {"const": "REJECTED_QUALITY_AS_CLEAN_BASELINE"},
        "removal_status": {
          "enum": ["AWAITING_USER_VISUAL_REVIEW", "PASS", "REJECTED_QUALITY"]
        },
        "automatic_gates": {"type": "object", "additionalProperties": true},
        "human_review_required": {"const": true}
      }
    },
    "consumer_firewall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_consumers", "forbidden_consumers", "enforced_by"],
      "properties": {
        "allowed_consumers": {
          "const": ["CLEAN_MASK_QA", "VISUAL_INPAINT"]
        },
        "forbidden_consumers": {
          "const": ["DEPTH", "OBJECT6D", "CONTACT", "ROBOT_GEOMETRY", "CONTROL_GROUND_TRUTH"]
        },
        "enforced_by": {"type": "string", "minLength": 1}
      }
    },
    "claim_limit": {"type": "string", "minLength": 1}
  }
}
