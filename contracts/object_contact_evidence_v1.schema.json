{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chaoyang://contracts/object_contact_evidence_v1.schema.json",
  "title": "OBJECT_CONTACT_EVIDENCE_INDEX_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_revision",
    "input_artifact_ids",
    "input_manifest_sha",
    "producer_signature",
    "supersedes_artifact_id",
    "validity",
    "evidence_nodes"
  ],
  "properties": {
    "schema_version": {"const": "OBJECT_CONTACT_EVIDENCE_INDEX_V1"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "artifact_revision": {"type": "string", "pattern": "^R[0-9]+_[0-9]+$"},
    "input_artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "input_manifest_sha": {"$ref": "#/$defs/sha256"},
    "producer_signature": {"$ref": "#/$defs/sha256"},
    "supersedes_artifact_id": {
      "oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
    },
    "validity": {
      "enum": ["VALID_FOR_PINNED_REVISION", "STALE_FOR_LATEST_REVISION"]
    },
    "evidence_nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence_node"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_type",
        "parent_evidence_ids",
        "evidence_depth",
        "may_support_contact_authority",
        "may_support_object6d_authority",
        "may_support_gold_contact_accuracy",
        "may_upgrade_tactile_supported_contact"
      ],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/id"},
        "evidence_type": {
          "enum": [
            "DIRECT_OBJECT6D",
            "BIDIRECTIONAL_TRACKED",
            "CONTACT_SEED",
            "HAND_OBJECT_ATTACHMENT",
            "UNKNOWN"
          ]
        },
        "parent_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "evidence_depth": {"type": "integer", "minimum": 0},
        "may_support_contact_authority": {"type": "boolean"},
        "may_support_object6d_authority": {"type": "boolean"},
        "may_support_gold_contact_accuracy": {"type": "boolean"},
        "may_upgrade_tactile_supported_contact": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"evidence_type": {"const": "HAND_OBJECT_ATTACHMENT"}}},
          "then": {
            "properties": {
              "may_support_contact_authority": {"const": false},
              "may_support_object6d_authority": {"const": false},
              "may_support_gold_contact_accuracy": {"const": false},
              "may_upgrade_tactile_supported_contact": {"const": false}
            }
          }
        },
        {
          "if": {"properties": {"evidence_type": {"const": "UNKNOWN"}}},
          "then": {
            "properties": {
              "may_support_contact_authority": {"const": false},
              "may_support_object6d_authority": {"const": false},
              "may_support_gold_contact_accuracy": {"const": false},
              "may_upgrade_tactile_supported_contact": {"const": false}
            }
          }
        }
      ]
    }
  }
}
