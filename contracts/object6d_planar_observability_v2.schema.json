{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "object6d-planar-observability-v2",
  "title": "0915 observed-only planar Object6D observability with entity semantics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "session_id",
    "frame_count",
    "coordinate_domain",
    "center_xyz_semantics",
    "external_accuracy",
    "hidden_geometry_inferred",
    "unified_confidence_emitted",
    "contact_authority",
    "robot_authority",
    "inputs",
    "objects",
    "support_entities",
    "semantic_groups",
    "observable_frame_counts",
    "claim_limit"
  ],
  "properties": {
    "schema_version": {"const": "object6d-planar-observability-v2"},
    "status": {"const": "COMPLETED_DEVELOPMENT_OBSERVABILITY"},
    "session_id": {"const": "play_cards_0915_001"},
    "frame_count": {"type": "integer", "minimum": 1},
    "coordinate_domain": {"const": "PHYSICAL_LEFT_ENCODED_RESIZE_ONLY_OPTICAL_Z"},
    "center_xyz_semantics": {"const": "DIRECT_VISIBLE_SURFACE_CENTROID_NOT_FULL_OBJECT_CENTER"},
    "external_accuracy": {"const": "UNVERIFIED"},
    "hidden_geometry_inferred": {"const": false},
    "unified_confidence_emitted": {"const": false},
    "contact_authority": {"const": "NONE"},
    "robot_authority": {"const": "NONE"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depth_result",
        "depth_adapter_contract",
        "depth_rgb_alignment_qa",
        "depth_contract",
        "depth_summary",
        "depth_frame_manifest",
        "depth_to_sam_mapping",
        "sam_role_manifest",
        "sam_temporal_state_ledger",
        "sam_masks"
      ],
      "properties": {
        "depth_result": {"$ref": "#/$defs/artifact"},
        "depth_adapter_contract": {"$ref": "#/$defs/artifact"},
        "depth_rgb_alignment_qa": {"$ref": "#/$defs/artifact"},
        "depth_contract": {"$ref": "#/$defs/artifact"},
        "depth_summary": {"$ref": "#/$defs/artifact"},
        "depth_frame_manifest": {"$ref": "#/$defs/artifact"},
        "depth_to_sam_mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "formula_x", "formula_y", "source", "target"],
          "properties": {
            "type": {"const": "ANALYTIC_PIXEL_CENTER_2X"},
            "formula_x": {"const": "x_sam = 2*x_depth + 0.5"},
            "formula_y": {"const": "y_sam = 2*y_depth + 0.5"},
            "source": {"const": "ORIGINAL_PHYSICAL_LEFT_640x480"},
            "target": {"const": "PHYSICAL_LEFT_SOURCEINDEX_1_RESIZE_ONLY_1280x960"}
          }
        },
        "sam_role_manifest": {"$ref": "#/$defs/artifact"},
        "sam_temporal_state_ledger": {"$ref": "#/$defs/artifact"},
        "sam_masks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["playing_card_00", "playing_card_01", "playing_card_02"],
          "properties": {
            "playing_card_00": {"$ref": "#/$defs/artifact"},
            "playing_card_01": {"$ref": "#/$defs/artifact"},
            "playing_card_02": {"$ref": "#/$defs/artifact"}
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/card00"},
        {"$ref": "#/$defs/card01"},
        {"$ref": "#/$defs/card02"}
      ],
      "items": false
    },
    "support_entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [{"$ref": "#/$defs/blackCardTray"}],
      "items": false
    },
    "semantic_groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [{"$ref": "#/$defs/cardSet"}],
      "items": false
    },
    "observable_frame_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playing_card_00", "playing_card_01", "playing_card_02"],
      "properties": {
        "playing_card_00": {"$ref": "#/$defs/counts"},
        "playing_card_01": {"$ref": "#/$defs/counts"},
        "playing_card_02": {"$ref": "#/$defs/counts"}
      }
    },
    "claim_limit": {"type": "string", "minLength": 40}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["center_xyz", "plane_normal", "inplane_rotation", "full_extent"],
      "properties": {
        "center_xyz": {"type": "integer", "minimum": 0},
        "plane_normal": {"type": "integer", "minimum": 0},
        "inplane_rotation": {"type": "integer", "minimum": 0},
        "full_extent": {"type": "integer", "minimum": 0}
      }
    },
    "estimate": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "xyz_m": {"$ref": "#/$defs/vec3"},
            "unit_xyz": {"$ref": "#/$defs/vec3"},
            "sign_convention": {"const": "Z_NONPOSITIVE_FACES_CAMERA"},
            "axis_unit_xyz": {"$ref": "#/$defs/vec3"},
            "angle_about_plane_normal_rad_mod_pi": {"type": "number", "minimum": 0, "maximum": 3.141592653589793},
            "symmetry_period_rad": {"const": 3.141592653589793},
            "extent_along_plane_axes_m": {"$ref": "#/$defs/vec2"}
          },
          "minProperties": 1
        }
      ]
    },
    "residual": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "median_radial_spread_m": {"type": "number", "minimum": 0},
            "p90_radial_spread_m": {"type": "number", "minimum": 0},
            "median_plane_distance_m": {"type": "number", "minimum": 0},
            "p90_plane_distance_m": {"type": "number", "minimum": 0},
            "small_to_middle_singular_ratio": {"type": "number", "minimum": 0},
            "major_to_minor_variance_ratio": {"type": "number", "minimum": 0},
            "median_orthogonal_spread_m": {"type": "number", "minimum": 0},
            "p90_orthogonal_spread_m": {"type": "number", "minimum": 0}
          },
          "minProperties": 1
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observability", "estimate", "residual", "reason", "semantics"],
      "properties": {
        "observability": {
          "enum": [
            "UNOBSERVABLE",
            "OBSERVABLE_VISIBLE_SURFACE_CENTROID",
            "OBSERVABLE_DIRECT_VISIBLE_PLANE",
            "OBSERVABLE_PI_PERIODIC_MAJOR_AXIS",
            "OBSERVABLE_FULL_VISIBLE_BOUNDARY_EXTENT"
          ]
        },
        "estimate": {"$ref": "#/$defs/estimate"},
        "residual": {"$ref": "#/$defs/residual"},
        "reason": {"type": ["string", "null"]},
        "semantics": {"type": "string", "minLength": 10}
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_index",
        "mask_state",
        "visibility_state",
        "mask_pixel_count",
        "registered_valid_depth_count",
        "registered_valid_depth_fraction",
        "center_xyz",
        "plane_normal",
        "inplane_rotation",
        "full_extent",
        "hidden_geometry_inferred"
      ],
      "properties": {
        "frame_index": {"type": "integer", "minimum": 0},
        "mask_state": {"enum": ["seeded", "tracked", "reseeded", "unknown"]},
        "visibility_state": {"enum": ["DIRECT_VISIBLE_PIXELS_ONLY", "OCCLUDED", "UNKNOWN"]},
        "mask_pixel_count": {"type": "integer", "minimum": 0},
        "registered_valid_depth_count": {"type": "integer", "minimum": 0},
        "registered_valid_depth_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "center_xyz": {"$ref": "#/$defs/component"},
        "plane_normal": {"$ref": "#/$defs/component"},
        "inplane_rotation": {"$ref": "#/$defs/component"},
        "full_extent": {"$ref": "#/$defs/component"},
        "hidden_geometry_inferred": {"const": false}
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "entity_role", "geometry_class", "frames"],
      "properties": {
        "instance_id": {"type": "string"},
        "entity_role": {"const": "PHYSICAL_TASK_OBJECT"},
        "geometry_class": {"const": "PLAYING_CARD_VISIBLE_PLANE"},
        "frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frame"}}
      }
    },
    "card00": {
      "allOf": [
        {"$ref": "#/$defs/card"},
        {"properties": {"instance_id": {"const": "playing_card_00"}}}
      ]
    },
    "card01": {
      "allOf": [
        {"$ref": "#/$defs/card"},
        {"properties": {"instance_id": {"const": "playing_card_01"}}}
      ]
    },
    "card02": {
      "allOf": [
        {"$ref": "#/$defs/card"},
        {"properties": {"instance_id": {"const": "playing_card_02"}}}
      ]
    },
    "blackCardTray": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "entity_role",
        "mask_evidence",
        "observability",
        "geometry_authority",
        "reason"
      ],
      "properties": {
        "instance_id": {"const": "black_card_tray"},
        "entity_role": {"const": "SUPPORT_ENTITY"},
        "mask_evidence": {"const": "ABSENT"},
        "observability": {"const": "UNKNOWN"},
        "geometry_authority": {"const": "NONE"},
        "reason": {"const": "INDEPENDENT_SUPPORT_MASK_NOT_AVAILABLE"}
      }
    },
    "cardSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "group_type",
        "member_instance_ids",
        "mask_authority",
        "geometry_authority",
        "pose_authority"
      ],
      "properties": {
        "group_id": {"const": "card_set"},
        "group_type": {"const": "SEMANTIC_MEMBERSHIP_ONLY"},
        "member_instance_ids": {
          "const": ["playing_card_00", "playing_card_01", "playing_card_02"]
        },
        "mask_authority": {"const": "NONE"},
        "geometry_authority": {"const": "NONE"},
        "pose_authority": {"const": "NONE"}
      }
    },
    "vec2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number", "minimum": 0}
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    }
  }
}
