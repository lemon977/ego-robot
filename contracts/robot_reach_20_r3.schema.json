    "hard_geometry_pass": {"const": false},
    "hard_target_contract_pass": {"type": "boolean"},
    "soft_pose_similarity_pass": {"type": "boolean"},
    "visual_train_eligible": {"type": "boolean"},
    "metric_contact_eligible": {"const": false},
    "side_gates": {"type": "array", "minItems": 1},
    "input": {"type": "object"},
    "authority": {"const": false},
    "control_ground_truth": {"const": false},
    "physical_deployment_authorized": {"const": false},
    "claim_limit": {"type": "string", "minLength": 1}
  }
}
