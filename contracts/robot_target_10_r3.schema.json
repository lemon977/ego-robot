{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chaoyang://contracts/robot_target_10_r3.schema.json",
  "title": "R3 ROBOT-TARGET-10 diagnostic proxy",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "artifact_revision", "task_id", "task", "session", "terminal_status", "robot_tier", "evidence_class", "object6d_consumed", "workspace_bounds_consumed", "hard_target_contract_pass", "soft_pose_similarity_pass", "gates", "sides", "inputs", "authority", "control_ground_truth", "physical_deployment_authorized", "claim_limit"],
  "properties": {
    "schema_version": {"const": "robot-target-10-audit-v1"},
    "artifact_revision": {"const": "R7_ROBOT_5_TARGET_10"},
    "task_id": {"const": "ROBOT-TARGET-10"},
    "task": {"enum": ["chips", "poker"]},
    "session": {"type": "string", "minLength": 1},
    "terminal_status": {"enum": ["PASSED", "FAILED_QUALITY_C"]},
    "robot_tier": {"const": "NONE"},
    "evidence_class": {"const": "DIAGNOSTIC_PROXY"},
    "object6d_consumed": {"const": false},
    "workspace_bounds_consumed": {"const": false},
    "hard_target_contract_pass": {"type": "boolean"},
    "soft_pose_similarity_pass": {"type": "boolean"},
    "gates": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
    "sides": {"type": "array", "minItems": 1},
    "inputs": {"type": "object", "minProperties": 1},
    "authority": {"const": false},
    "control_ground_truth": {"const": false},
    "physical_deployment_authorized": {"const": false},
    "claim_limit": {"type": "string", "pattern": "DIAGNOSTIC_PROXY"}
  }
}
