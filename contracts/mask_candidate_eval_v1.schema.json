{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ego-robot.local/contracts/mask_candidate_eval_v1.schema.json",
  "title": "Frozen Candidate View for MASK Benchmarking",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_state", "producer", "candidate_id", "producer_version",
    "benchmark_manifest_ref", "frames", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "mask-candidate-eval-v1"},
    "artifact_state": {"enum": ["FROZEN", "SYNTHETIC_TEST_ONLY"]},
    "producer": {"const": "mask_candidate_manifest_adapter"},
    "candidate_id": {"type": "string", "minLength": 1},
    "producer_version": {"type": "string", "minLength": 1},
    "benchmark_manifest_ref": {"$ref": "#/$defs/ref"},
    "frames": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_id", "source_image_sha256", "predicted_human_mask"],
        "properties": {
          "sample_id": {"type": "string", "minLength": 1},
          "source_image_sha256": {"$ref": "#/$defs/sha256"},
          "predicted_human_mask": {"$ref": "#/$defs/ref"}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "producer", "schema_version"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "producer": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1}
      }
    }
  }
}
