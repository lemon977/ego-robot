{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaoyang.local/contracts/handle_sensor_pipeline_admission_ledger_v71.schema.json",
  "title": "Handle Sensor Pipeline H0 Admission Ledger V7.1",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "processed_root",
    "row_count",
    "dataset_result_evidence",
    "summary",
    "rows",
    "claim_limit"
  ],
  "properties": {
    "schema_version": {"const": "handle-sensor-pipeline-admission-ledger-v7.1"},
    "generated_at": {"type": "string"},
    "processed_root": {"type": "string"},
    "row_count": {"type": "integer", "minimum": 1},
    "dataset_result_evidence": {"type": "array", "minItems": 2},
    "summary": {"type": "object"},
    "claim_limit": {"type": "string", "minLength": 20},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "dataset_id", "date_tag", "task", "source_session_id", "session_id",
          "source_terminal", "frame_count", "content_admission", "admission",
          "primary_blockers", "eligibility", "downstream", "input_evidence", "claim_limit"
        ],
        "properties": {
          "dataset_id": {"enum": ["chips_cards_handle_0909", "chips_cards_handle_0910"]},
          "date_tag": {"enum": ["0909", "0910"]},
          "task": {"enum": ["potato_chips", "playing_cards"]},
          "source_session_id": {"type": "string"},
          "session_id": {"type": "string", "minLength": 10},
          "frame_count": {"type": ["integer", "null"], "minimum": 1},
          "content_admission": {"type": "string"},
          "admission": {
            "enum": ["SENSOR_GEOMETRY_READY", "VISUAL_ONLY", "BLOCKED_SOURCE"]
          },
          "primary_blockers": {"type": "array", "items": {"type": "string"}},
          "source_terminal": {"type": "object"},
          "eligibility": {
            "type": "object",
            "required": [
              "visual_rgb", "manus25", "controller_wrist", "tactile",
              "source_stereo", "camera_contract", "cadence"
            ]
          },
          "downstream": {"type": "object"},
          "input_evidence": {"type": "array"},
          "claim_limit": {"type": "string", "minLength": 20}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
