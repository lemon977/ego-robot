{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot-physical-calibration-collection-v1.schema.json",
  "title": "Measured Robot TCP, mount and camera/base calibration collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "robot_tcp", "tool_to_kaihand_root", "camera_to_base", "real_robot_action"],
  "properties": {
    "schema_version": {"const": "robot-physical-calibration-collection-v1"},
    "authority": {"enum": ["BLOCKED_EXTERNAL", "MEASURED_EXTERNAL_EVIDENCE"]},
    "robot_tcp": {"$ref": "#/$defs/sidedEvidence"},
    "tool_to_kaihand_root": {"$ref": "#/$defs/sidedEvidence"},
    "camera_to_base": {"$ref": "#/$defs/evidence"},
    "real_robot_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "artifact"],
      "properties": {
        "status": {"enum": ["ABSENT", "PRESENT_MEASURED"]},
        "artifact": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]}
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "matrix4": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {"type": "number"}
      }
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "coordinate_definition", "translation_units", "matrix", "measurement"],
          "properties": {
            "status": {"const": "ABSENT"},
            "coordinate_definition": {"type": "string", "minLength": 1},
            "translation_units": {"const": "metres"},
            "matrix": {"type": "null"},
            "measurement": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "coordinate_definition", "translation_units", "matrix", "measurement", "provider", "method", "calibration_id", "timestamp_ns"],
          "properties": {
            "status": {"const": "PRESENT_MEASURED"},
            "coordinate_definition": {"type": "string", "minLength": 1},
            "translation_units": {"const": "metres"},
            "matrix": {"$ref": "#/$defs/matrix4"},
            "measurement": {"$ref": "#/$defs/artifact"},
            "provider": {"type": "string", "minLength": 1},
            "method": {"type": "string", "minLength": 1},
            "calibration_id": {"type": "string", "minLength": 1},
            "timestamp_ns": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "sidedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right"],
      "properties": {
        "left": {"$ref": "#/$defs/evidence"},
        "right": {"$ref": "#/$defs/evidence"}
      }
    }
  }
}
