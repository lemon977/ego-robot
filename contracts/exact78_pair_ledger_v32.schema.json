{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chaoyang://contracts/exact78_pair_ledger_v32.schema.json",
  "title": "EXACT78_PAIR_LEDGER_V32",
  "type": "object",
  "required": [
    "schema_version", "status", "contract", "release_id", "task", "branch",
    "seed", "input_mode", "image_domain", "units", "side", "validity",
    "observability", "temporal_authority", "producer_identity", "cohort_authority",
    "source_bindings", "suffix_invariance_receipts", "pair_production_readiness",
    "train", "validation", "development_final", "occlusion_hardset",
    "pair_dataset_signature", "control_ground_truth",
    "physical_deployment_authorized", "external_metric_authority"
  ],
  "properties": {
    "schema_version": {"const": "EXACT78_PAIR_LEDGER_V32"},
    "status": {"const": "PASS_EXACT78_PAIR_LEDGER_V32"},
    "contract": {"const": "EXACT78_V32_REAL_CAUSAL_PAIR"},
    "release_id": {"const": "EXACT78_V32_DEVELOPMENT"},
    "task": {"enum": ["chips", "poker"]},
    "branch": {"enum": ["HUMAN_RAW_RGB", "ROBOTIZED_RGB"]},
    "seed": {"const": 7},
    "input_mode": {"const": "CAUSAL_TRAINING_INPUT"},
    "image_domain": {"const": "SOURCE_DOMAIN_BOUND_PER_BUNDLE"},
    "units": {"const": "RGB_UINT8_AND_NORMALIZED_IMAGE_XY"},
    "side": {"const": "BUNDLE_DECLARED_PHYSICAL_SIDE"},
    "validity": {"const": "EXPLICIT_SHARED_VALID_MASK_NO_FILL"},
    "observability": {"const": "OBSERVED_AND_INFERRED_EXPLICITLY_SEPARATED"},
    "temporal_authority": {"const": "CAUSAL_CURRENT_INPUT_NONCAUSAL_TARGET"},
    "producer_identity": {"$ref": "#/$defs/producer"},
    "cohort_authority": {"$ref": "#/$defs/artifact"},
    "source_bindings": {
      "type": "array", "minItems": 2,
      "items": {"$ref": "#/$defs/source_binding"}
    },
    "suffix_invariance_receipts": {
      "type": "array", "minItems": 2,
      "items": {"type": "object"}
    },
    "pair_production_readiness": {
      "type": "array", "minItems": 2,
      "items": {"type": "object"}
    },
    "train": {"$ref": "#/$defs/artifacts"},
    "validation": {"$ref": "#/$defs/artifacts"},
    "development_final": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "occlusion_hardset": {"$ref": "#/$defs/artifact"},
    "pair_dataset_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "control_ground_truth": {"const": false},
    "physical_deployment_authorized": {"const": false},
    "external_metric_authority": {"const": false}
  },
  "additionalProperties": true,
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "producer": {
      "type": "object",
      "required": ["producer_sha256", "config_sha256", "input_sha256"],
      "properties": {
        "producer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    },
    "source_binding": {
      "type": "object",
      "required": [
        "session_id", "source_group_id", "split", "source_frame",
        "timestamp", "current_source_lineage", "input_sha256", "status"
      ],
      "properties": {
        "session_id": {"type": "string"},
        "source_group_id": {"type": "string"},
        "split": {"enum": ["train", "validation"]},
        "source_frame": {"const": "BUNDLE_FRAME_IDS"},
        "timestamp": {"const": "BUNDLE_TIMESTAMPS"},
        "current_source_lineage": {"type": "string", "minLength": 1},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"const": "RESOLVED_EXACT_FROZEN_IDENTITY"}
      },
      "additionalProperties": true
    }
  }
}
