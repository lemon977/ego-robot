{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chaoyang://contracts/quality/cross_stage_admission_output_v1.schema.json",
  "title": "Chaoyang cross-stage admission output V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "task_id",
    "input_contract",
    "categories",
    "routes",
    "blame"
  ],
  "properties": {
    "schema_version": {
      "const": "chaoyang-cross-stage-admission-v1"
    },
    "session_id": {
      "type": ["string", "null"]
    },
    "task_id": {
      "type": ["string", "null"]
    },
    "input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "schema_errors",
        "evidence_verification_errors"
      ],
      "properties": {
        "valid": {"type": "boolean"},
        "schema_errors": {
          "type": "array",
          "items": {"type": "string"}
        },
        "evidence_verification_errors": {
          "type": "array",
          "items": {"type": "string"}
        },
        "evidence_files_rehashed": {"type": "boolean"}
      }
    },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_capture",
        "hawor_algorithm",
        "mask_semantic",
        "mask_temporal",
        "clean_donor",
        "clean_photometric",
        "robot_geometry",
        "robot_authority",
        "training_eligibility"
      ],
      "properties": {
        "upstream_capture": {"$ref": "#/$defs/category"},
        "hawor_algorithm": {"$ref": "#/$defs/category"},
        "mask_semantic": {"$ref": "#/$defs/category"},
        "mask_temporal": {"$ref": "#/$defs/category"},
        "clean_donor": {"$ref": "#/$defs/category"},
        "clean_photometric": {"$ref": "#/$defs/category"},
        "robot_geometry": {"$ref": "#/$defs/category"},
        "robot_authority": {"$ref": "#/$defs/category"},
        "training_eligibility": {"$ref": "#/$defs/category"}
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hawor_rgb_execution_allowed",
        "mask_execution_allowed",
        "mask_formal_ready",
        "clean_execution_allowed",
        "clean_formal_ready",
        "robot_motion_execution_allowed",
        "robot_sidecar_ready",
        "robot_composite_execution_allowed",
        "robot_formal_ready",
        "humanego_train_eligible"
      ],
      "properties": {
        "hawor_rgb_execution_allowed": {"type": "boolean"},
        "mask_execution_allowed": {"type": "boolean"},
        "mask_formal_ready": {"type": "boolean"},
        "clean_execution_allowed": {"type": "boolean"},
        "clean_formal_ready": {"type": "boolean"},
        "robot_motion_execution_allowed": {"type": "boolean"},
        "robot_sidecar_ready": {"type": "boolean"},
        "robot_composite_execution_allowed": {"type": "boolean"},
        "robot_formal_ready": {"type": "boolean"},
        "humanego_train_eligible": {"type": "boolean"}
      }
    },
    "blame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "observed_failures",
        "holds_or_not_evaluated",
        "suppressed_downstream_failures",
        "required_product_graph_targets",
        "policy"
      ],
      "properties": {
        "primary": {
          "type": "array",
          "items": {"$ref": "#/$defs/primary_blame"}
        },
        "observed_failures": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "holds_or_not_evaluated": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "suppressed_downstream_failures": {
          "type": "array",
          "items": {"$ref": "#/$defs/suppressed_failure"}
        },
        "required_product_graph_targets": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "uniqueItems": true
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "status": {
      "enum": ["PASS", "FAIL", "HOLD", "NOT_EVALUATED"]
    },
    "authority": {
      "enum": ["CAPTURE", "PRODUCER", "INDEPENDENT_QA", "HUMAN_REVIEW", "NONE"]
    },
    "gate_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "observed_status", "status", "authority", "reason_codes"],
      "properties": {
        "gate": {"type": "string", "minLength": 1},
        "observed_status": {"$ref": "#/$defs/status"},
        "status": {"$ref": "#/$defs/status"},
        "authority": {"$ref": "#/$defs/authority"},
        "reason_codes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "observed_status", "status", "reason_codes"],
      "properties": {
        "gate": {"type": "string", "minLength": 1},
        "observed_status": {"$ref": "#/$defs/status"},
        "status": {"$ref": "#/$defs/status"},
        "reason_codes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "category": {
      "type": "object",
      "required": ["name", "status", "gates", "blockers"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "gates": {
          "type": "array",
          "items": {"$ref": "#/$defs/gate_row"},
          "minItems": 1
        },
        "blockers": {
          "type": "array",
          "items": {"$ref": "#/$defs/blocker"}
        },
        "causal_status": {
          "enum": ["PASS", "FAIL", "HOLD", "NOT_EVALUATED", "BLOCKED_BY_UPSTREAM"]
        },
        "dependency_statuses": {
          "type": "array",
          "items": {"$ref": "#/$defs/status"}
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["route", "status"],
            "properties": {
              "route": {"type": "string", "minLength": 1},
              "status": {"$ref": "#/$defs/status"}
            }
          }
        },
        "eligible": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "primary_blame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "route", "status", "reason_codes"],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "route": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "reason_codes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "suppressed_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "observed_status", "causal_status", "not_primary_because"],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "observed_status": {"const": "FAIL"},
        "causal_status": {"const": "BLOCKED_BY_UPSTREAM"},
        "not_primary_because": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
