{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ego-robot.local/contracts/temporal_atlas_manifest.schema.json",
  "title": "Verified Temporal Background Donor Atlas Manifest",
  "x-document-status": "DRAFT",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_state", "producer", "status", "execution_mode",
    "formal_consumable", "session_id", "product_line", "frame_index", "route_id",
    "reveal_class", "reveal_policy_ref", "source_manifest_ref", "source_frame_refs",
    "temporal_window", "donor_frames", "rgb_ref", "background_identity_mask_ref",
    "support_mask_ref", "rgb_sha256", "background_identity_mask_sha256",
    "support_mask_sha256", "coverage_ratio", "flow_consistency",
    "photometric_residual_normalized", "identity_checks", "fallback_used", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "temporal-background-donor-v1"},
    "artifact_state": {
      "enum": ["G2_CALIBRATION_CANDIDATE", "FORMAL_PRODUCTION_CANDIDATE", "SYNTHETIC_TEST_ONLY"]
    },
    "producer": {"const": "temporal_donor_atlas"},
    "status": {"const": "VERIFIED"},
    "execution_mode": {"enum": ["G2_CALIBRATION", "FORMAL_PRODUCTION", "SYNTHETIC_DRY_RUN"]},
    "formal_consumable": {"type": "boolean"},
    "session_id": {"type": "string", "minLength": 1},
    "product_line": {"enum": ["004_CONTACT_GOLD", "EXACT78_R2_VISUAL_DOMAIN"]},
    "frame_index": {"type": "integer", "minimum": 0},
    "route_id": {"const": "TEMPORAL_DONOR_ATLAS"},
    "reveal_class": {"const": "REVEAL_BACKGROUND"},
    "reveal_policy_ref": {"$ref": "#/$defs/revealPolicyRef"},
    "source_manifest_ref": {"$ref": "#/$defs/ref"},
    "source_frame_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "temporal_window": {
      "type": "object", "additionalProperties": false,
      "required": ["window_seconds", "measured_fps", "derived_frame_radius", "formula_ref"],
      "properties": {
        "window_seconds": {"type": "number", "exclusiveMinimum": 0},
        "measured_fps": {"type": "number", "exclusiveMinimum": 0},
        "derived_frame_radius": {"type": "integer", "minimum": 1},
        "formula_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "donor_frames": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["frame_index", "frame_ref", "source_unmasked", "occlusion_free", "forward_backward_consistency", "photometric_residual_normalized"],
        "properties": {
          "frame_index": {"type": "integer", "minimum": 0},
          "frame_ref": {"$ref": "#/$defs/ref"},
          "source_unmasked": {"const": true},
          "occlusion_free": {"const": true},
          "forward_backward_consistency": {"type": "number", "minimum": 0, "maximum": 1},
          "photometric_residual_normalized": {"type": "number", "minimum": 0}
        }
      }
    },
    "rgb_ref": {"$ref": "#/$defs/ref"},
    "background_identity_mask_ref": {"$ref": "#/$defs/ref"},
    "support_mask_ref": {"$ref": "#/$defs/ref"},
    "rgb_sha256": {"$ref": "#/$defs/sha256"},
    "background_identity_mask_sha256": {"$ref": "#/$defs/sha256"},
    "support_mask_sha256": {"$ref": "#/$defs/sha256"},
    "coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "flow_consistency": {"type": "number", "minimum": 0, "maximum": 1},
    "photometric_residual_normalized": {"type": "number", "minimum": 0},
    "identity_checks": {
      "type": "object", "additionalProperties": false,
      "required": [
        "background_identity_pixel_count", "support_pixel_count",
        "support_outside_background_identity_pixel_count", "protected_object_overlap_pixel_count",
        "human_or_uncertain_source_overlap_pixel_count", "evidence_ref"
      ],
      "properties": {
        "background_identity_pixel_count": {"type": "integer", "minimum": 0},
        "support_pixel_count": {"type": "integer", "minimum": 0},
        "support_outside_background_identity_pixel_count": {"const": 0},
        "protected_object_overlap_pixel_count": {"const": 0},
        "human_or_uncertain_source_overlap_pixel_count": {"const": 0},
        "evidence_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "formal_authorization_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]},
    "fallback_used": {"const": false},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"execution_mode": {"const": "SYNTHETIC_DRY_RUN"}}},
      "then": {
        "properties": {
          "artifact_state": {"const": "SYNTHETIC_TEST_ONLY"},
          "formal_consumable": {"const": false},
          "formal_authorization_ref": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"execution_mode": {"const": "G2_CALIBRATION"}}},
      "then": {
        "properties": {
          "artifact_state": {"const": "G2_CALIBRATION_CANDIDATE"},
          "formal_consumable": {"const": false},
          "formal_authorization_ref": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"execution_mode": {"const": "FORMAL_PRODUCTION"}}},
      "then": {
        "required": ["formal_authorization_ref"],
        "properties": {
          "artifact_state": {"const": "FORMAL_PRODUCTION_CANDIDATE"},
          "formal_consumable": {"const": true},
          "formal_authorization_ref": {"$ref": "#/$defs/ref"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "producer", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "producer": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "revealPolicyRef": {
      "allOf": [
        {"$ref": "#/$defs/ref"},
        {"properties": {"producer": {"const": "reveal_policy_owner"}, "schema_version": {"const": "reveal-policy-v1"}}, "required": ["schema_version"]}
      ]
    }
  }
}
