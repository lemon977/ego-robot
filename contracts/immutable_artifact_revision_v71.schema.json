{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaoyang.local/contracts/immutable_artifact_revision_v71.schema.json",
  "title": "Chaoyang V7.1 immutable artifact revision metadata",
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_revision",
    "input_artifact_ids",
    "input_artifact_revisions",
    "input_manifest_sha",
    "producer_signature",
    "supersedes_artifact_id",
    "validity"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_revision": {
      "type": "string",
      "pattern": "^R[0-9]+_[0-9]+(?:[._-][A-Za-z0-9]+)*$"
    },
    "input_artifact_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "input_artifact_revisions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^R[0-9]+_[0-9]+(?:[._-][A-Za-z0-9]+)*$"
      }
    },
    "input_manifest_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "producer_signature": {
      "type": "string",
      "minLength": 1
    },
    "supersedes_artifact_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "validity": {
      "enum": [
        "VALID_FOR_PINNED_REVISION",
        "STALE_FOR_LATEST_REVISION"
      ]
    }
  },
  "additionalProperties": true
}
