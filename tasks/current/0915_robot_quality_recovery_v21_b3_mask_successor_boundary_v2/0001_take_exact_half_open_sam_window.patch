+def take_exact_frozen_window(
+    propagation: Iterator[tuple[Any, Any]],
+    *,
+    start: int,
+    end_exclusive: int,
+) -> Iterator[tuple[Any, Any]]:
+    """Consume exactly the half-open frozen window, never its poison boundary.
+
+    The pinned SAM3 multiplex tracker interprets ``max_frame_num_to_track`` as
+    an inclusive forward span in ``_get_processing_order`` but as an exclusive
+    upper bound in its batched detector.  For a 64-frame partial window the
+    normal iterator therefore has 65 processing indices and the 65th creates
+    an empty detector batch.  The caller still passes the frozen span to the
+    model, but this adapter requests only the 64 promised outputs and closes
+    the generator without asking for the inconsistent boundary index.
+
+    Frame order and cardinality remain fail-closed.  This function does not
+    alter prompts, model weights, thresholds, windows, masks, or identities.
+    """
+    if end_exclusive <= start:
+        raise ValueError("frozen window must be non-empty")
+    try:
+        for expected_frame in range(start, end_exclusive):
+            try:
+                item = next(propagation)
+            except StopIteration as exc:
+                raise RuntimeError(
+                    "SAM propagation ended before the frozen window was complete: "
+                    f"expected frame {expected_frame}"
+                ) from exc
+            frame_index, outputs = item
+            if int(frame_index) != expected_frame:
+                raise RuntimeError(
+                    "SAM propagation violated frozen sequential frame order: "
+                    f"expected {expected_frame}, got {int(frame_index)}"
+                )
+            yield frame_index, outputs
+    finally:
+        close = getattr(propagation, "close", None)
+        if callable(close):
+            close()
+
